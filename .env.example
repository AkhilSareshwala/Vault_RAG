# VaultRAG v4 environment variables.
# Copy this file to .env and fill in real values.

# Get your free Groq API key at console.groq.com (no credit card needed)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Any non-empty string works for local development
LITELLM_MASTER_KEY=sk-vaultrag-master-key

# This matches what is in docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/vaultrag

# Use a long random string in production
JWT_SECRET=dev-secret-change-in-real-deployment

QDRANT_HOST=localhost
QDRANT_PORT=6333
